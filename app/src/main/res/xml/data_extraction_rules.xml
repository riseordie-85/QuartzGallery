<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the personal folder's passcode and key out of Google backups and phone-to-phone transfers:
     they only make sense on this phone, next to its encrypted files (which aren't backed up either). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vault.xml" />
        <exclude domain="sharedpref" path="vault_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vault.xml" />
        <exclude domain="sharedpref" path="vault_key.xml" />
    </device-transfer>
</data-extraction-rules>
