<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon (monochrome) layer. Android only uses the shape; the system picks the color. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Scaled to 81% around the lens center (54,54) so it lines up with the full-color art -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.81"
        android:scaleY="0.81">

        <!-- Outer quartz ring -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 54 22 C 36.3 22 22 36.3 22 54 C 22 71.7 36.3 86 54 86 C 60 86 65.6 84.3 70.3 81.5 L 63 68 C 60.2 69.3 57.2 70 54 70 C 45.2 70 38 62.8 38 54 C 38 45.2 45.2 38 54 38 C 62.8 38 70 45.2 70 54 C 70 56.4 69.4 58.7 68.3 60.8 L 81.6 68 C 84.4 63.8 86 59 86 54 C 86 36.3 71.7 22 54 22 Z" />

        <!-- Crystal shard tail of the Q -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 62 62 L 72 90 L 92 82 L 82 54 Z" />

        <!-- Camera lens (vector drawables don't support <circle>, so it's drawn as two arcs) -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 44 54 A 10 10 0 1 0 64 54 A 10 10 0 1 0 44 54 Z" />
    </group>
</vector>
